[Unit]
Description=arcus-vol weekday evening blackout pause (bot-strategy#1093)
[Timer]
# Mon..Thu only: Friday 20:00 New York is the HOOD/SLV weekend pause (Sat 00:00 UTC);
# an evening resume at 20:05 Friday would restart a weekend-paused bot.
OnCalendar=Mon..Thu *-*-* 19:55:00 America/New_York
Persistent=false
[Install]
WantedBy=timers.target
