[Unit]
Description="debot-arcus-vol-gld (bot-strategy#1093 Arcus presence/volume runtime, GLD-USD, operator-started)"
After=network-online.target
Wants=network-online.target
# Rate limit for Restart= below (a [Unit] setting since systemd 230).
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Environment=DEBOT_ARCUS_VOL_ETC_DIR=/etc/debot-arcus-vol-gld
Type=simple
# Leading '-' (see debot-bull-holder.service): systemd applies WorkingDirectory
# BEFORE ExecStart, so on a fresh host an un-prefixed path would CHDIR-fail the
# unit before the deploy created the directory.
WorkingDirectory=-/var/lib/debot-arcus-vol-gld
# The launcher checks credentials, sentinels, the venue (flat, no open orders)
# and sizes the quotes from free collateral, then execs the runtime, so the
# runtime itself is the main process.
# Per-market dead man's switch lead (bot-strategy#1093, 2026-10-14): 60 s instead of the
# 30 s default (refresh stays 10 s). On 10-14 refreshes stuck behind slow venue REST calls
# missed the 30 s deadline ~10x per wallet and exhausted the venue's 10 auto-fires/UTC day.
Environment=ARCUS_VOL_DMS_SECS=60
ExecStart=/bin/bash /opt/debot/scripts/debot-arcus-vol.sh
# A crash is retried, slowly: the venue's dead man's switch (60 s) has already
# cancelled the quotes by then, and the runtime's startup reconcile cancels /
# adopts whatever is left. A deliberate stop (KILL_SWITCH / HALT sentinel) makes
# the launcher exit 0, which on-failure does not retry.
Restart=on-failure
RestartSec=60
TimeoutStartSec=120
# SIGTERM -> the runtime's cancel-all, final fill harvest, state persist, and
# dead-man's-switch disarm; give it room before SIGKILL.
TimeoutStopSec=120
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
