[Unit]
Description=Archive durable Arcus live-tick events to private S3
Documentation=https://github.com/shigeo-nakamura/bot-strategy/issues/825
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=arcus
Group=arcus
UMask=0077
Environment=STATE_DIR=/var/lib/debot-arcus/spot-execute-once
Environment=S3_BUCKET=debot-dashboard
Environment=S3_PREFIX=arcus-archive/live-tick-events/debot-arcus
ExecStart=/usr/local/libexec/debot/archive_arcus_live_tick_events.sh
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
