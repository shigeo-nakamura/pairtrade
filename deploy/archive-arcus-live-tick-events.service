[Unit]
Description=Archive durable Arcus live-tick events to private S3
Documentation=https://github.com/shigeo-nakamura/bot-strategy/issues/825
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=arcus
Group=arcus
UMask=0077
Environment=STATE_DIR=/var/lib/debot-arcus/spot-execute-once
Environment=ARCUS_CHECKPOINT_LOCK_PATH=/var/lib/debot-arcus/spot-execute-once/.runtime_state.json.lock
Environment=ARCUS_PENDING_EVENT_PATH=/var/lib/debot-arcus/spot-execute-once/live-tick-event-pending.json
Environment=ARCHIVE_START_MARKER=/var/lib/debot-arcus-archive/live-tick-events.start-date
Environment=ARCHIVE_HIGH_WATER_MARKER=/var/lib/debot-arcus-archive/live-tick-events.high-water-date
Environment=S3_BUCKET=debot-dashboard
Environment=S3_PREFIX=arcus-archive/live-tick-events/debot-arcus
ExecStart=/usr/local/libexec/debot/archive_arcus_live_tick_events.sh
TimeoutStartSec=900
StateDirectory=debot-arcus-archive
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
