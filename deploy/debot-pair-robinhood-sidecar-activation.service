[Unit]
Description=Prepare the Robinhood Lighter sidecar for the pinned bot runtime
After=network-online.target
Wants=network-online.target
Before=debot-pair-robinhood-lighter.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/debot/scripts/activate-robinhood-sidecar.sh /opt/debot /run/debot-pair-robinhood-lighter/runtime
