# debot-xvenue-hedge-arcus.env — second xvenue_hedge_holder instance (bot-strategy#1123, reused by #1228)
#   long  = Arcus Perps AAPL-USD   (wallet 0x812B…DF05, subaccount 0)
#   short = Lighter Core AAPL      (Core sub-account 281474976574527, API key index 24)
# Host path: /opt/debot/scripts/debot-xvenue-hedge-arcus.env (root:root 0600). Key lines are
# ciphertext under the host data key and are NEVER committed — the host file keeps them.
# All assignments are `export NAME="value"` (the launcher plain-sources this file).

# ---- mode -------------------------------------------------------------------
# Install in DRY_RUN; /tmp/arcus_hold_arm.sh flips to live with both confirm tokens.
export HEDGE_DRY_RUN="true"
# export HEDGE_LIVE_CONFIRM="1046-G0-PASSED"
# export HEDGE_ARCUS_LIVE_CONFIRM="1080"

# ---- venues -----------------------------------------------------------------
export HEDGE_LONG_VENUE="arcus"
export HEDGE_LONG_INSTANCE="arcus"
export HEDGE_SHORT_VENUE="lighter"
export HEDGE_SHORT_INSTANCE="core"

# ---- book (#1228: AAPL $20k/leg, 2026-10-28 19:00Z .. 2026-11-04 19:00Z) ------
# SYMBOL:LONG_MMR/SHORT_MMR. Arcus AAPL-USD maintenanceMarginFraction 0.033334 (IMF 5 %,
# off-hours IMF 7.5 %) → 5 for the guard (conservative). Lighter Core AAPL MMR 3 % (300).
export HEDGE_SYMBOLS="AAPL:5/3"
export HEDGE_TARGET_NOTIONAL_USD="20000"
export HEDGE_MAX_NOTIONAL_USD="22000"
# IOC clip; legs alternate per clip. Arcus AAPL top 5 levels ≈ $10–20k (10-23).
export HEDGE_CLIP_USD="2500"
export HEDGE_TAKER_SLIPPAGE_BPS="5"
# |long − short| × mark above this stops growth; 3 ticks in a row → halt.
export HEDGE_NET_TOLERANCE_USD="3000"
export HEDGE_NET_BREACH_TICKS="3"
# headroom = equity/notional − MMR per venue; below → close both legs + halt.
#   Arcus  $5.8k / $20k − 5 % ≈ 24 %; Lighter $5k / $20k − 3 % = 22 %.
export HEDGE_LIQ_GUARD_PCT="8"
# notional/equity above this refuses growth: Arcus 20k/5.8k ≈ 3.4x, Lighter 20k/5k = 4.0x.
export HEDGE_MAX_LEVERAGE="4.5"
export HEDGE_TICK_SECS="30"
export HEDGE_FILL_WAIT_SECS="3,6,10"
export HEDGE_UNCERTAIN_GRACE_SECS="60"
export HEDGE_DRY_RUN_EQUITY_USD="5000"
# No roll: this is a hold test, not volume.
export HEDGE_ROLL_ENABLED="false"

# ---- status mirror (separate object from the first instance) -----------------
export HEDGE_STATUS_S3_URI="s3://debot-dashboard/debot/status/robinhood-lighter/xvenue-hedge-arcus.json"
export HEDGE_STATUS_S3_EVERY_SECS="60"

# ---- long leg: Arcus (suffix _ARCUS) ------------------------------------------
export ARCUS_ADDRESS_ARCUS="0x812B6A6da8E0dF1fBCA7939ae32089Cf85c5DF05"
export ARCUS_ACCOUNT_INDEX_ARCUS="0"
export ARCUS_REST_ENDPOINT_ARCUS="https://api.arcus.xyz"
export ARCUS_WEBSOCKET_ENDPOINT_ARCUS="wss://api.arcus.xyz/v1/ws"
export ARCUS_API_KEY_ARCUS="<kept on host>"
export ARCUS_API_PRIVATE_KEY_ARCUS="<ciphertext, kept on host>"

# ---- short leg: Lighter Core (suffix _CORE) ------------------------------------
export REST_ENDPOINT_CORE="https://mainnet.zklighter.elliot.ai"
export WEB_SOCKET_ENDPOINT_CORE="wss://mainnet.zklighter.elliot.ai/stream"
export LIGHTER_ACCOUNT_INDEX_CORE="281474976574527"
export LIGHTER_API_KEY_INDEX_CORE="24"
export LIGHTER_PUBLIC_API_KEY_CORE="<ciphertext, kept on host>"
export LIGHTER_PRIVATE_API_KEY_CORE="<ciphertext, kept on host>"
