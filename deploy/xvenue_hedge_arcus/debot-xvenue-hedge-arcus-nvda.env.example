# debot-xvenue-hedge-arcus-nvda.env — NVDA hedge-holder instance (bot-strategy#1293, second hold)
#   long  = Arcus Perps NVDA-USD   (wallet 0xA2C7…66d6, subaccount 0 — the retired #1093 SPY volume wallet)
#   short = Lighter Core NVDA      (Core sub-account 281474976624889, API key index <idx>)
# Host path: /opt/debot/scripts/debot-xvenue-hedge-arcus-nvda.env (root:root 0600). Key lines are
# ciphertext under the host data key and are NEVER committed — install_hedge_arcus_nvda.sh fills them
# on the host (Arcus lines copied from /etc/debot-arcus-vol/live.env, Lighter lines from the owner's
# fragment). All assignments are `export NAME="value"` (the launcher plain-sources this file).

# ---- mode -------------------------------------------------------------------
# Install in DRY_RUN; the owner-run ARM script flips to live with both confirm tokens.
export HEDGE_DRY_RUN="true"
# export HEDGE_LIVE_CONFIRM="1046-G0-PASSED"
# export HEDGE_ARCUS_LIVE_CONFIRM="1080"

# ---- venues -----------------------------------------------------------------
export HEDGE_LONG_VENUE="arcus"
export HEDGE_LONG_INSTANCE="arcus"
export HEDGE_SHORT_VENUE="lighter"
export HEDGE_SHORT_INSTANCE="core"

# ---- book (#1293: NVDA $20k/leg from 2026-11; the 11-12 decision keeps $20k until the first
# weekly drop shows NVDA's pt/$ — a later $40k needs Arcus collateral ≥ $9k first) -----------
# SYMBOL:LONG_MMR/SHORT_MMR. Arcus NVDA-USD maintenanceMarginFraction 0.033334 (IMF 5 %,
# off-hours IMF 7.5 %) → 5 for the guard (conservative). Lighter Core NVDA MMR 3 % (300).
export HEDGE_SYMBOLS="NVDA:5/3"
# $20k/leg at HEDGE_MAX_LEVERAGE 4.5 needs >= ~$4.5k equity on each venue (Arcus $5.26k on 11-12).
export HEDGE_TARGET_NOTIONAL_USD="20000"
export HEDGE_MAX_NOTIONAL_USD="22000"
# IOC clip; legs alternate per clip. Arcus NVDA OI $3.9M of a $16M cap (11-12).
export HEDGE_CLIP_USD="2500"
export HEDGE_TAKER_SLIPPAGE_BPS="5"
# |long − short| × mark above this stops growth; 3 ticks in a row → halt.
export HEDGE_NET_TOLERANCE_USD="3000"
export HEDGE_NET_BREACH_TICKS="3"
# headroom = equity/notional − MMR per venue; below → close both legs + halt.
#   Arcus  $5.2k / $20k − 5 % ≈ 21 %; Lighter $5k / $20k − 3 % = 22 %.
export HEDGE_LIQ_GUARD_PCT="8"
# notional/equity above this refuses growth: Arcus 20k/5.2k ≈ 3.8x, Lighter 20k/5k = 4.0x.
export HEDGE_MAX_LEVERAGE="4.5"
export HEDGE_TICK_SECS="30"
export HEDGE_FILL_WAIT_SECS="3,6,10"
export HEDGE_UNCERTAIN_GRACE_SECS="60"
export HEDGE_DRY_RUN_EQUITY_USD="5000"
# No roll: this is a hold, not volume.
export HEDGE_ROLL_ENABLED="false"

# ---- status mirror (own object; the launcher derives and checks this name) ----
export HEDGE_STATUS_S3_URI="s3://debot-dashboard/debot/status/robinhood-lighter/xvenue-hedge-arcus-nvda.json"
export HEDGE_STATUS_S3_EVERY_SECS="60"

# ---- long leg: Arcus (suffix _ARCUS) ------------------------------------------
export ARCUS_ADDRESS_ARCUS="0xa2c78e14dfd5586444ce4fe28fc4e36308a066d6"
export ARCUS_ACCOUNT_INDEX_ARCUS="0"
export ARCUS_REST_ENDPOINT_ARCUS="https://api.arcus.xyz"
export ARCUS_WEBSOCKET_ENDPOINT_ARCUS="wss://api.arcus.xyz/v1/ws"
export ARCUS_API_KEY_ARCUS="<ARCUS_API_KEY from /etc/debot-arcus-vol/live.env>"
export ARCUS_API_PRIVATE_KEY_ARCUS="<ARCUS_API_PRIVATE_KEY ciphertext from /etc/debot-arcus-vol/live.env>"

# ---- short leg: Lighter Core (suffix _CORE) ------------------------------------
export REST_ENDPOINT_CORE="https://mainnet.zklighter.elliot.ai"
export WEB_SOCKET_ENDPOINT_CORE="wss://mainnet.zklighter.elliot.ai/stream"
export LIGHTER_ACCOUNT_INDEX_CORE="281474976624889"
export LIGHTER_API_KEY_INDEX_CORE="<LIGHTER_API_KEY_INDEX_CORE from the owner's fragment>"
export LIGHTER_PUBLIC_API_KEY_CORE="<LIGHTER_PUBLIC_API_KEY_CORE ciphertext from the owner's fragment>"
export LIGHTER_PRIVATE_API_KEY_CORE="<LIGHTER_PRIVATE_API_KEY_CORE ciphertext from the owner's fragment>"
