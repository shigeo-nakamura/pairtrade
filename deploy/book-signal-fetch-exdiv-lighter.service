[Unit]
Description=Fetch the exdiv-lighter signal file from S3 for book-runtime (bot-strategy#948 / #937)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=book-runtime
Group=book-runtime
# BOOK_SIGNAL_MAX_AGE_SECS, generated by install_book_runtime.sh from the
# validated config's signal.max_age_secs so the two can never drift.
EnvironmentFile=/opt/book-runtime/exdiv-lighter.fetch.env
ExecStart=/opt/book-runtime/bin/book_signal_fetch.sh s3://debot-dashboard/debot/book/exdiv-lighter/signal.json /var/lib/book-runtime/exdiv-lighter/signal.json
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/book-runtime/exdiv-lighter
PrivateTmp=true
NoNewPrivileges=true
