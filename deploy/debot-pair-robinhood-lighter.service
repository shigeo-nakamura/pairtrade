[Unit]
Description=Robinhood Chain Lighter BTC/ETH pairtrade
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=-/opt/debot-robinhood-lighter
ExecStartPre=+/usr/bin/install -d -o ec2-user -g ec2-user -m 0750 /opt/debot-robinhood-lighter /home/ec2-user/debot_status
ExecStart=/bin/bash /opt/debot/scripts/debot-pair-robinhood-lighter.sh
Environment=PROM_LISTEN=127.0.0.1:9464
Environment=STATUS_S3_BUCKET=debot-dashboard
Environment=STATUS_S3_KEY_PREFIX=debot/status/robinhood-lighter
Restart=on-failure
RestartSec=30
StartLimitBurst=5
# Allow the 3,660s strategy grace to expire (bot-strategy#798, force_close
# halved 7200->3600 on 2026-08-17), then leave three minutes for the final
# reduce-only exchange close and orderly process shutdown.
TimeoutStopSec=3840
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
