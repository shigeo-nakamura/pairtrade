[Unit]
Description=Robinhood Chain Lighter BTC/ETH pairtrade
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=-/opt/debot-robinhood-lighter
ExecStartPre=+/usr/bin/install -d -o ec2-user -g ec2-user -m 0750 /opt/debot-robinhood-lighter /home/ec2-user/debot_status
ExecStart=/bin/bash /opt/debot/scripts/debot-pair-robinhood-lighter.sh
Restart=on-failure
RestartSec=30
StartLimitBurst=5
# Allow the 10,860s strategy grace to expire, then leave three minutes for
# the final reduce-only exchange close and orderly process shutdown.
TimeoutStopSec=11040
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
