[Unit]
Description=Archive closed Engine B Phase 0 SQLite partitions to S3
After=network-online.target engine-b-phase0.service
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
Environment=ENGINE_B_PHASE0_DATA_DIR=/var/lib/engine-b-phase0/data
Environment=ENGINE_B_PHASE0_S3_BUCKET=debot-dashboard
Environment=ENGINE_B_PHASE0_S3_PREFIX=debot/engine-b/phase0/raw
ExecStart=/bin/bash /opt/debot/scripts/engine_b_phase0_archive.sh
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/engine-b-phase0
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
UMask=0077
