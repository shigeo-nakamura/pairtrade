[Unit]
Description=Archive yesterday's [EVAL] + restart timestamps to S3 (bot-strategy#255)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/debot
ExecStart=/opt/debot/scripts/archive_bt_replay_events.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
