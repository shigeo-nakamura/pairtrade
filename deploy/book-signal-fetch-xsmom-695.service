[Unit]
Description=Fetch the xsmom-695 signal file from S3 for book-runtime (bot-strategy#937)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=book-runtime
Group=book-runtime
ExecStart=/opt/book-runtime/bin/book_signal_fetch.sh s3://debot-dashboard/debot/book/xsmom-695/signal.json /var/lib/book-runtime/xsmom-695/signal.json
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/book-runtime/xsmom-695
PrivateTmp=true
NoNewPrivileges=true
