[Unit]
Description=Read-only Engine B Phase 0 archive and capacity metrics
After=engine-b-phase0.service

[Service]
Type=simple
User=engine-b-phase0
Group=engine-b-phase0
ExecStart=/usr/bin/python3 /opt/engine-b-phase0/engine_b_archive_monitor.py --retention-hours 24
Restart=on-failure
RestartSec=10
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/engine-b-phase0
InaccessiblePaths=/opt/debot
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
