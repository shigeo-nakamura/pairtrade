[Unit]
Description="debot-pair-btceth-extended (Tokyo, bot-strategy#123)"
After=network.target

[Service]
# Tokyo Extended is isolated under /opt/debot-extended so Tokyo Lighter
# (bot-strategy#218) can install its own binary at /opt/debot/bin/debot
# on the same instance without colliding.
Environment=DEBOT_HOME=/opt/debot-extended
WorkingDirectory=/opt/debot-extended
ExecStart=/bin/bash /opt/debot-extended/scripts/debot-pair-btceth-extended.sh
Restart=on-failure
RestartSec=30
StartLimitBurst=5
# bot-strategy#269: match the longest configured shutdown_grace_secs across
# live + grid YAMLs (live=10860, grid=14460). Without this systemd defaults
# to 90s and SIGKILLs the bot mid graceful close, leaving positions to be
# adverse-priced by the next process's `[Startup] Force closing` path
# (observed 4/29 10:36 / 4/30 09:58).
TimeoutStopSec=14460
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
