# debot-arcus-vol — Arcus Perps presence / volume runtime (bot-strategy#1093)
#
# Two files live in /etc/debot-arcus-vol/ (directory mode 700, root):
#
#   live.env    Arcus API credentials. MUST be mode 600. Never commit real values;
#               the deploy workflow never writes this file.
#   config.env  market / sizing / stops. Optional: every key has the default
#               shown below. Changes take effect at the next (operator) start.
#
# debot-arcus-vol.sh reads both as plain `NAME=value` lines (an optional `export`
# prefix is accepted) and exports them to the runtime. The files are parsed, not
# sourced: values may only contain [A-Za-z0-9_./:+=,-], and only the keys listed
# in this file are accepted (an unknown key -- e.g. an endpoint override or a
# second ARCUS_ACCOUNT_INDEX in config.env -- refuses the start).

# ============================ /etc/debot-arcus-vol/live.env ============================
# Wallet address the API key was registered for (subaccount 0).
ARCUS_ADDRESS=0x0000000000000000000000000000000000000000
# Trade-only Ed25519 API key registered on Arcus for accountIndex 0.
ARCUS_API_KEY=REPLACE_ME
# Signing key, KMS-encrypted under the host's data key (production). Write the
# plain key as ARCUS_PLAIN_API_PRIVATE_KEY first, then run once as root:
#   sudo /opt/debot/scripts/arcus_vol_encrypt_key.sh
# which replaces it with the two lines below (base64 of IV||AES-256-CBC, the
# scripts/encrypt.py format debot-utils decrypts). ENCRYPTED_DATA_KEY may be
# omitted here: the launcher then takes it from
# /opt/debot/scripts/debot_secrets_common.env (the hosts' shared data key; the
# KMS key is in eu-central-1, which is debot-utils' default -- do not set
# AWS_REGION).
ARCUS_API_PRIVATE_KEY=REPLACE_ME_BASE64_CIPHERTEXT
# ENCRYPTED_DATA_KEY=REPLACE_ME_BASE64
# Testing only: a plain hex key. The launcher refuses it unless config.env sets
# ALLOW_PLAIN_KEY=1, and never exports it together with the encrypted one.
# ARCUS_PLAIN_API_PRIVATE_KEY=REPLACE_ME_64_HEX
# The launcher refuses anything but 0 (the bot shares subaccount 0 with manual
# trading; its dead man's switch is account-wide, see the operations doc).
ARCUS_ACCOUNT_INDEX=0

# =========================== /etc/debot-arcus-vol/config.env ===========================
# Market to quote (exactly one per runtime; the account lock allows one runtime
# per subaccount).
MARKET=SPY-USD
# Per-side quote size in USD. The launcher also caps it by what the account's
# FREE collateral supports at LEVERAGE (free * LEVERAGE / 2 * 0.9, rounded down
# to $100); inventory cap = 2 clips, margin = cap / LEVERAGE. Refuses below $500.
CLIP_MAX_USD=2500
# Presence quoting: quotes rest QUOTE_OFFSET_BPS behind the touch and are
# re-pegged only when they drift more than REPEG_BAND_BPS from that (band must
# be >= 1 and < offset). 0 = quote at the touch (volume mode).
QUOTE_OFFSET_BPS=5
REPEG_BAND_BPS=2
# Optional session offset (bot-strategy#1093): while the market's venue session
# is open (US equity/ETF perps: 04:00-20:00 New York, weekdays; the venue's own
# isOutsideRth flag decides, holidays included) quotes rest SESSION_OFFSET_BPS
# behind the touch instead, re-pegged outside SESSION_BAND_BPS; QUOTE_OFFSET_BPS
# / REPEG_BAND_BPS then apply off-hours and at weekends. Set both or neither;
# QUOTE_OFFSET_BPS must be > 0 when set. Example (SPY, grid_report 2026-10-05:
# in-session 2 bp cost ~1.4 bp/$, off-hours ~0.1 bp/$):
#   QUOTE_OFFSET_BPS=2  REPEG_BAND_BPS=1  SESSION_OFFSET_BPS=5  SESSION_BAND_BPS=2
# SESSION_OFFSET_BPS=5
# SESSION_BAND_BPS=2
# Stops (USD, net of fees, mark-to-market). Daily: halt until the next UTC day.
# Cumulative: sticky HALT sentinel, cleared by the operator only.
DAILY_STOP_USD=5
CUM_STOP_USD=21
# Runtime leverage used for the inventory cap (the venue-side setting for the
# market should be >= this).
LEVERAGE=5
# State (state.json, status.json, fills.jsonl, KILL_SWITCH / HALT sentinels)
# and the per-account lock. Defaults match the deploy workflow's directories.
STATE_DIR=/var/lib/debot-arcus-vol/state
LOCK_DIR=/var/lib/debot-arcus-vol/locks
# Testing only: start with ARCUS_PLAIN_API_PRIVATE_KEY from live.env (the
# connector logs "using PLAIN API private key (testing only)" on every start).
# ALLOW_PLAIN_KEY=1
# RUST_LOG=info
