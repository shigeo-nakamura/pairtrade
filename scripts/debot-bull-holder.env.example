# debot-bull-holder.env — bull-mode holder (bot-strategy#893/#894/#895)
# Copy to /opt/debot/scripts/debot-bull-holder.env. Never commit real values.
#
# Every assignment below MUST use `export NAME="value"` (schema mirrors
# debot-pair-canary.env) — debot-bull-holder.sh sources this file with a
# plain `source`, not `set -a`, so a bare `NAME=value` line stays a local
# shell variable and never reaches the bull-holder process's environment.
# This cost real debugging time on first deploy (bot-strategy#895,
# 2026-09-04): the binary panicked with "LIGHTER_PUBLIC_API_KEY must be set"
# even though the file had a value, because it wasn't exported.

# ---- identity / mode -------------------------------------------------------
export BULL_HOLDER_INSTANCE_ID="bull-holder"
# The binary refuses `false` until the #895 rollout gates are lifted in code.
export BULL_HOLDER_DRY_RUN="true"

# ---- book -------------------------------------------------------------------
export BULL_HOLDER_SYMBOLS="BTC,ETH"
# Total capital across both venues. Spot gets SPOT_FRACTION of it (Hyperliquid),
# perp notional PERP_FRACTION of it (Lighter, margin only is parked there).
export BULL_HOLDER_EQUITY_USD="1000"
export BULL_HOLDER_SPOT_FRACTION="0.90"
export BULL_HOLDER_PERP_FRACTION="0.45"
# Build the book in N equal daily tranches after ARM (1 = all at once). The
# first fills immediately, the rest one per UTC day. Recommended 5: pinning
# the entry day is not possible, and up to N=7 the #893 P1 gate still passes
# (cost vs one-shot is a few points; N>=10 costs 5-30 points -- that is DCA,
# not an entry, and is capped at 30 by the binary).
export BULL_HOLDER_ENTRY_TRANCHES="5"
# Daily-close exit and the wider Lighter exchange-stop insurance level.
export BULL_HOLDER_EXIT_DD_PCT="30"
export BULL_HOLDER_STOP_DD_PCT="35"
# Hyperliquid spot market per symbol (defaults: UBTC/USDC, UETH/USDC).
# export BULL_HOLDER_HL_SPOT_BTC="UBTC/USDC"
# export BULL_HOLDER_HL_SPOT_ETH="UETH/USDC"

# ---- Hyperliquid account (spot legs) ---------------------------------------
# Account that OWNS the funds (master or sub-account), not the API wallet.
export HYPERLIQUID_ACCOUNT_ADDRESS="0x0000000000000000000000000000000000000000"
# KMS-encrypted API-wallet private key (decrypted with ENCRYPTED_DATA_KEY from
# debot_secrets_common.env). Leave unset for a read-only / DRY_RUN connector.
# export HYPERLIQUID_SIGNER_PRIVATE_KEY=""
export HYPERLIQUID_NONCE_STATE_PATH="/opt/debot-bull-holder/bull_holder/hl_nonce.json"
export HYPERLIQUID_MAX_TAKER_NOTIONAL_USD="2000"
export HYPERLIQUID_MAX_TAKER_SLIPPAGE_BPS="50"
export HYPERLIQUID_MAX_TAKER_BOOK_AGE_MS="5000"

# ---- Lighter sub-account (perp legs) ---------------------------------------
# Dedicated sub-account; schema mirrors debot-pair-canary.env.
export LIGHTER_PUBLIC_API_KEY=""
export LIGHTER_PRIVATE_API_KEY=""
export LIGHTER_API_KEY_INDEX=""
export LIGHTER_WALLET_ADDRESS=""
export LIGHTER_EVM_WALLET_PRIVATE_KEY=""
export LIGHTER_ACCOUNT_INDEX=""
