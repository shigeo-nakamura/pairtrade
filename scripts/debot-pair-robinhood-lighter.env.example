# KMS-encrypted API credentials for Robinhood Chain Lighter.
# ENCRYPTED_DATA_KEY is loaded separately from debot_secrets_common.env.
LIGHTER_PUBLIC_API_KEY=<kms-aes-ciphertext>
LIGHTER_PRIVATE_API_KEY=<kms-aes-ciphertext>
LIGHTER_API_KEY_INDEX=4
LIGHTER_ACCOUNT_INDEX=3209
ROBINHOOD_LIGHTER_DRY_RUN=true
