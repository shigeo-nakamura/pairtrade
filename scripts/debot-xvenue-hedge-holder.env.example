# debot-xvenue-hedge-holder.env — cross-venue points hedge (bot-strategy#1046)
# Copy to /opt/debot/scripts/debot-xvenue-hedge-holder.env on the Tokyo
# Robinhood host. Never commit real values.
#
# Every assignment MUST use `export NAME="value"`: debot-xvenue-hedge-holder.sh
# sources this file with a plain `source`, not `set -a` (bot-strategy#895
# lesson: a bare NAME=value never reaches the process).

# ---- mode -----------------------------------------------------------------
# Live needs BOTH lines; the token is the pre-registered G0 readout gate.
export HEDGE_DRY_RUN="true"
# export HEDGE_LIVE_CONFIRM="1046-G0-PASSED"

# ---- book -----------------------------------------------------------------
export HEDGE_SYMBOL="BTC"
# Several symbols instead (overrides HEDGE_SYMBOL / HEDGE_MMR_PCT): each with
# the venue's maintenance margin % (orderBookDetails maintenance_margin_fraction
# / 100). Guards are per ACCOUNT over all of them; see the operations doc.
# export HEDGE_SYMBOLS="BTC:1.2,META:3,AMZN:6,GOOGL:3"
# Per-leg notional built on `touch ARM` (an ARM file containing a number
# overrides it); MAX caps what any ARM may ask for.
# $16k on ~$4k per venue is 4x; keep it under HEDGE_MAX_LEVERAGE with room
# for an adverse tick on the last clip (a $20k target on $4,000 is exactly
# 5.0x and would trip a 5x guard mid-build).
export HEDGE_TARGET_NOTIONAL_USD="16000"
export HEDGE_MAX_NOTIONAL_USD="30000"
# Largest single IOC. The legs are built/unwound in alternating clips, so
# this is also the most the book can be lopsided by between two orders.
export HEDGE_CLIP_USD="10000"
# Taker bound past the touch (bps). RH L1 is thin (median $380, p75 $15k);
# 3 bps covered a $20k clip in one IOC on 2026-09-19.
export HEDGE_TAKER_SLIPPAGE_BPS="3"
# |long - short| x mark over this (USD) stops growth; over it for
# NET_BREACH_TICKS consecutive ticks halts (RISK_ACK to clear).
export HEDGE_NET_TOLERANCE_USD="500"
export HEDGE_NET_BREACH_TICKS="3"
# Lighter BTC maintenance margin 1.20% (orderBookDetails, bot-strategy#909).
# Headroom = equity/notional - MMR; below LIQ_GUARD both legs are closed and
# the bot halts. At $4,000 equity behind a $20k leg headroom is 18.8%, so 8%
# fires at ~$1,840 equity on that venue (a ~10% adverse move on ONE leg).
export HEDGE_MMR_PCT="1.2"
export HEDGE_LIQ_GUARD_PCT="8"
# Growth is refused beyond this notional/equity on either venue (checked
# for the whole tick's orders before the first is sent).
export HEDGE_MAX_LEVERAGE="6"
export HEDGE_TICK_SECS="30"
# DRY_RUN only: the equity both venues are assumed to hold.
export HEDGE_DRY_RUN_EQUITY_USD="4000"

# ---- status mirror (debot-dashboard reads this) ---------------------------
export HEDGE_STATUS_S3_URI="s3://debot-dashboard/debot/status/robinhood-lighter/xvenue-hedge-holder.json"
export HEDGE_STATUS_S3_EVERY_SECS="60"
# Points collector history (bot-strategy#938); the long account's rows feed
# the dashboard's cost-per-point block. Default is the collector's path.
# export HEDGE_POINTS_HISTORY_PATH="/home/ec2-user/debot_status/robinhood-points/points_history.jsonl"

# ---- long leg: Lighter on Robinhood Chain (instance suffix _RH) ----------
# The same account_index 3209 / keys as the freq arm
# (debot-pair-robinhood-lighter.env), encrypted under this host's
# ENCRYPTED_DATA_KEY (debot_secrets_common.env).
export HEDGE_LONG_INSTANCE="rh"
export REST_ENDPOINT_RH="https://api.rh.lighter.xyz"
export WEB_SOCKET_ENDPOINT_RH="wss://api.rh.lighter.xyz/stream"
export LIGHTER_ACCOUNT_INDEX_RH="3209"
export LIGHTER_API_KEY_INDEX_RH="0"
export LIGHTER_PUBLIC_API_KEY_RH=""
export LIGHTER_PRIVATE_API_KEY_RH=""

# ---- short leg: Lighter Core (instance suffix _CORE) ---------------------
# The old canary sub-account (index 281474976624819). Its keys were
# encrypted under the FRANKFURT data key: re-encrypt them under this host's
# ENCRYPTED_DATA_KEY before use (same procedure as the xsmom-695 secrets,
# bot-strategy#937).
export HEDGE_SHORT_INSTANCE="core"
export REST_ENDPOINT_CORE="https://mainnet.zklighter.elliot.ai"
export WEB_SOCKET_ENDPOINT_CORE="wss://mainnet.zklighter.elliot.ai/stream"
export LIGHTER_ACCOUNT_INDEX_CORE="281474976624819"
export LIGHTER_API_KEY_INDEX_CORE="0"
export LIGHTER_PUBLIC_API_KEY_CORE=""
export LIGHTER_PRIVATE_API_KEY_CORE=""

# ---- ALTERNATIVE short leg: Arcus Perps (bot-strategy#1080) ---------------
# Replaces the Core block above when the short leg moves to Arcus. Needs a
# binary built with `--features arcus-sdk` (the holder CI artifact is).
# The API key is an Ed25519 key registered to the owner's Arcus wallet
# (app.arcus.xyz/api-keys); the private half is KMS-encrypted under this
# host's ENCRYPTED_DATA_KEY like the Lighter keys.
# export HEDGE_SHORT_VENUE="arcus"
# export HEDGE_SHORT_INSTANCE="arcus"
# export ARCUS_ADDRESS_ARCUS="0xA2C78E14dfD5586444ce4FE28Fc4E36308A066d6"
# export ARCUS_ACCOUNT_INDEX_ARCUS="0"
# export ARCUS_API_KEY_ARCUS=""            # public key hex (optional cross-check)
# export ARCUS_API_PRIVATE_KEY_ARCUS=""    # KMS-encrypted Ed25519 seed hex
# export ARCUS_REST_ENDPOINT_ARCUS="https://api.arcus.xyz"          # testnet: https://api.testnet.arcus.xyz
# export ARCUS_WEBSOCKET_ENDPOINT_ARCUS="wss://api.arcus.xyz/v1/ws" # testnet: wss://api.testnet.arcus.xyz/v1/ws
# Per-leg MMR (long Lighter / short Arcus): Arcus BTC MMF 1.667 %, stocks 6.667 %.
# export HEDGE_SYMBOLS="BTC:1.2/1.667"
# Arcus acks orders asynchronously (202): re-read positions longer.
# export HEDGE_FILL_WAIT_SECS="3,6,10"
# Seconds before an unconfirmed (uncertain) IOC that is no longer open is
# released; until then nothing is sent on that symbol (default 60).
# seconds an unsettled (uncertain) order may wait for fill/cancel evidence
# before the bot halts for the operator (never auto-released on time)
# export HEDGE_UNCERTAIN_GRACE_SECS=60
# Second live gate for any Arcus leg (on top of HEDGE_LIVE_CONFIRM):
# export HEDGE_ARCUS_LIVE_CONFIRM="1080"
