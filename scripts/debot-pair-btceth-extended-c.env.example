# Tokyo Extended A/B/C variant C env file template (bot-strategy#306 Phase D).
# Copy to /opt/debot-extended/scripts/debot-pair-btceth-extended-c.env on the
# Tokyo host and fill in the real values. The file must be chmod 600 and owned
# by ec2-user because it contains a KMS-wrapped private key.
#
# ENCRYPTED_DATA_KEY is loaded from /opt/debot-extended/scripts/debot_secrets_common.env
# (inherited from the variant-A install), so it's NOT duplicated here.
#
# Endpoint settings (REST_ENDPOINT / WEB_SOCKET_ENDPOINT) are also set once in
# the shared yaml; only per-account credentials live here.

# REST API key (plaintext, sent in X-Api-Key header)
EXTENDED_API_KEY=

# StarkNet account public key (hex, 0x...)
EXTENDED_PUBLIC_KEY=

# StarkNet private key, KMS-encrypted (base64). Use
# `python3 /opt/debot/scripts/encrypt.py "$PLAINTEXT_DATA_KEY" "<priv-hex>"`
# to produce this value. See bot-strategy#306 sub-account setup notes.
EXTENDED_PRIVATE_KEY=

# Subaccount / vault id (u64). Different from variant A's VAULT and B's VAULT.
EXTENDED_VAULT=
