{
  "title": "Pairtrade overview",
  "uid": "pairtrade-overview",
  "tags": ["pairtrade", "bot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "z-score (per pair / variant)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "expr": "pairtrade_z{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} {{pair}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "debot-frankfurt-canary.*" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF66FF" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "z-score divergence: Frankfurt - Tokyo (per variant)",
      "description": "Frankfurt z minus Tokyo z, matched on pair+variant. Should sit near 0; non-zero pulses point at one host's WS lagging.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "pairtrade_z{instance=\"debot-frankfurt\",variant!=\"\"} - on(pair, variant) pairtrade_z{instance=\"debot-tokyo\",variant!=\"\"}",
          "legendFormat": "{{variant}} {{pair}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "spanNulls": false },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "red",    "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "z-score divergence: Frankfurt A/B/C - canary (per variant)",
      "description": "Frankfurt main z minus Frankfurt canary z, broadcast on pair (group_left) so canary's single series compares against each of A/B/C. Structural drift is expected per bot-strategy#410 (separate process, independent WS bar close); the panel is a direction indicator for binary-regression detection rather than a 'should be 0' alert. Requires canary added to Alloy scrape with instance=\"debot-frankfurt-canary\".",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "pairtrade_z{instance=\"debot-frankfurt\",variant!=\"\"} - on(pair) group_left pairtrade_z{instance=\"debot-frankfurt-canary\",variant!=\"\"}",
          "legendFormat": "{{variant}} {{pair}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "spanNulls": false },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red",    "value": 1.0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "beta (combined / short / long)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "targets": [
        { "expr": "pairtrade_beta{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} beta", "refId": "A" },
        { "expr": "pairtrade_beta_s{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} beta_s", "refId": "B" },
        { "expr": "pairtrade_beta_l{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} beta_l", "refId": "C" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "|beta_s - beta_l| (threshold 0.30)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "targets": [
        { "expr": "pairtrade_beta_divergence{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 0.30 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Variants currently in position",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 29 },
      "targets": [
        { "expr": "sum by (instance) (pairtrade_has_position{variant!=\"\"})", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "gray",  "value": null },
              { "color": "blue",  "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Position state (per instance / variant)",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 29 },
      "targets": [
        { "expr": "pairtrade_has_position{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} {{pair}}", "refId": "A" }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
                "0": { "color": "transparent", "text": "FLAT" },
                "1": { "color": "blue",        "text": "IN POSITION" }
            } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Position age (seconds, > 0 only while in position)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 37 },
      "targets": [
        { "expr": "pairtrade_position_age_seconds{variant!=\"\"} > 0", "legendFormat": "{{instance}} {{variant}} {{pair}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "Eligibility (cointegration filter)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 37 },
      "targets": [
        { "expr": "pairtrade_eligible{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} {{pair}}", "refId": "A" }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
                "0": { "color": "red",   "text": "NOT ELIGIBLE" },
                "1": { "color": "green", "text": "ELIGIBLE" }
            } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Time since last trade (seconds, -1 before first trade)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 44 },
      "targets": [
        { "expr": "pairtrade_time_since_last_trade_seconds{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} {{pair}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Close reasons (count last 24h)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 44 },
      "targets": [
        {
          "expr": "sum by (instance, variant, reason) (increase(pairtrade_close_reason_total{variant!=\"\"}[24h]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true },
            "indexByName": { "instance": 0, "variant": 1, "reason": 2, "Value #A": 3 },
            "renameByName": { "instance": "host", "Value #A": "count" }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              { "field": "host" },
              { "field": "variant" },
              { "field": "reason" }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true },
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "count" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "color", "value": { "mode": "continuous-GrYlRd" } },
              { "id": "custom.align", "value": "center" },
              { "id": "custom.width", "value": 80 }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Snapshot age (seconds)",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 51 },
      "targets": [
        { "expr": "pairtrade_snapshot_age_seconds{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 120 },
              { "color": "red",    "value": 600 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "heatmap",
      "title": "Close gross PnL distribution (bps of entry notional)",
      "description": "Per-close gross PnL (price moves only, fees+funding excluded) normalized by entry notional. Source for the #306 BT/live gap analysis: compare this distribution against BT output. (#314 Group 4-A, pairtrade#35)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "targets": [
        {
          "expr": "sum by (le) (increase(pairtrade_close_gross_pnl_bps_bucket{variant!=\"\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "options": {
        "yAxis": { "unit": "short" },
        "cellGap": 1,
        "color": { "mode": "scheme", "scheme": "Spectral", "steps": 64, "reverse": false }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Per-leg slippage p50/p90 (bps, by order_type)",
      "description": "Median + 90th-percentile slippage vs decision-time reference price, signed positive = cost. post_only fills typically hover near 0; taker fills are the adverse tail #306 cares about. (#314 Group 4-B/B-2, pairtrade#38/#42)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, order_type) (rate(pairtrade_leg_slippage_bps_bucket{variant!=\"\"}[$__rate_interval])))",
          "legendFormat": "p50 {{order_type}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le, order_type) (rate(pairtrade_leg_slippage_bps_bucket{variant!=\"\"}[$__rate_interval])))",
          "legendFormat": "p90 {{order_type}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Per-leg fee p50/p90 (bps of filled notional)",
      "description": "Venue-reported fee per leg. Lighter is fee-free and leaves the source unset (no series); Extended populates it. (#314 Group 4-B, pairtrade#38)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 64 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, leg) (rate(pairtrade_leg_fee_bps_bucket{variant!=\"\"}[$__rate_interval])))",
          "legendFormat": "p50 {{leg}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le, leg) (rate(pairtrade_leg_fee_bps_bucket{variant!=\"\"}[$__rate_interval])))",
          "legendFormat": "p90 {{leg}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "spanNulls": true }
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Per-leg fill latency p50/p90 (ms)",
      "description": "Wall-clock latency from PendingOrders placement to leg fill completion. Extended populates FilledOrder.filled_ts_ms; Lighter leaves it None and emits no series. (#314 Group 4-C, pairtrade#40)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 64 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, leg) (rate(pairtrade_leg_fill_latency_ms_bucket{variant!=\"\"}[$__rate_interval])))",
          "legendFormat": "p50 {{leg}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le, leg) (rate(pairtrade_leg_fill_latency_ms_bucket{variant!=\"\"}[$__rate_interval])))",
          "legendFormat": "p90 {{leg}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 2, "spanNulls": true }
        },
        "overrides": []
      }
    }
  ]
}
