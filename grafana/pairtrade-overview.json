{
  "title": "Pairtrade overview",
  "uid": "pairtrade-overview",
  "tags": ["pairtrade", "bot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "z-score (per pair / variant)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "expr": "pairtrade_z{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} {{pair}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "z-score divergence: Frankfurt - Tokyo (per variant)",
      "description": "Frankfurt z minus Tokyo z, matched on pair+variant. Should sit near 0; non-zero pulses point at one host's WS lagging.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "pairtrade_z{instance=\"debot-frankfurt\",variant!=\"\"} - on(pair, variant) pairtrade_z{instance=\"debot-tokyo\",variant!=\"\"}",
          "legendFormat": "{{variant}} {{pair}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "spanNulls": false },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "red",    "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "z-score divergence: Frankfurt A/B/C - canary (per variant)",
      "description": "Frankfurt main z minus Frankfurt canary z, broadcast on pair (group_left) so canary's single series compares against each of A/B/C. Structural drift is expected per bot-strategy#410 (separate process, independent WS bar close); the panel is a direction indicator for binary-regression detection rather than a 'should be 0' alert. Requires canary added to Alloy scrape with instance=\"debot-frankfurt-canary\".",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "pairtrade_z{instance=\"debot-frankfurt\",variant!=\"\"} - on(pair) group_left pairtrade_z{instance=\"debot-frankfurt-canary\",variant!=\"\"}",
          "legendFormat": "{{variant}} {{pair}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "spanNulls": false },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red",    "value": 1.0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "beta (combined / short / long)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "targets": [
        { "expr": "pairtrade_beta{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} beta", "refId": "A" },
        { "expr": "pairtrade_beta_s{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} beta_s", "refId": "B" },
        { "expr": "pairtrade_beta_l{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} beta_l", "refId": "C" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "|beta_s - beta_l| (threshold 0.30)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "targets": [
        { "expr": "pairtrade_beta_divergence{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 0.30 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Variants currently in position",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 29 },
      "targets": [
        { "expr": "sum by (instance) (pairtrade_has_position{variant!=\"\"})", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "gray",  "value": null },
              { "color": "blue",  "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Position state (per instance / variant)",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 29 },
      "targets": [
        { "expr": "pairtrade_has_position{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} {{pair}}", "refId": "A" }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
                "0": { "color": "transparent", "text": "FLAT" },
                "1": { "color": "blue",        "text": "IN POSITION" }
            } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Position age (seconds, > 0 only while in position)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 37 },
      "targets": [
        { "expr": "pairtrade_position_age_seconds{variant!=\"\"} > 0", "legendFormat": "{{instance}} {{variant}} {{pair}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "Eligibility (cointegration filter)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 37 },
      "targets": [
        { "expr": "pairtrade_eligible{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} {{pair}}", "refId": "A" }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
                "0": { "color": "red",   "text": "NOT ELIGIBLE" },
                "1": { "color": "green", "text": "ELIGIBLE" }
            } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "state-timeline",
      "title": "Risk halts (kill / session_dd / daily_dd / circuit_breaker)",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 44 },
      "targets": [
        { "expr": "pairtrade_kill_switch_active{variant!=\"\"}",     "legendFormat": "{{instance}} {{variant}} kill_switch", "refId": "A" },
        { "expr": "pairtrade_session_dd_halt_active{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} session_dd",  "refId": "B" },
        { "expr": "pairtrade_daily_dd_halt_active{variant!=\"\"}",   "legendFormat": "{{instance}} {{variant}} daily_dd",    "refId": "C" },
        { "expr": "pairtrade_circuit_breaker_active{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} cb",          "refId": "D" }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
                "0": { "color": "transparent" },
                "1": { "color": "red", "text": "HALTED" }
            } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Time since last trade (seconds, -1 before first trade)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 51 },
      "targets": [
        { "expr": "pairtrade_time_since_last_trade_seconds{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} {{pair}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Close reasons (rate last 24h)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 51 },
      "targets": [
        { "expr": "sum by (reason, variant, instance) (increase(pairtrade_close_reason_total{variant!=\"\"}[24h]))", "legendFormat": "{{instance}} {{variant}} {{reason}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Bot version",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 58 },
      "targets": [
        { "expr": "pairtrade_bot_version_info{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}} {{version}} {{git_sha}}", "refId": "A", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "name",
        "colorMode": "none"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Snapshot age (seconds)",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 58 },
      "targets": [
        { "expr": "pairtrade_snapshot_age_seconds{variant!=\"\"}", "legendFormat": "{{instance}} {{variant}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 120 },
              { "color": "red",    "value": 600 }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
