        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, variant, order_type) (rate(pairtrade_leg_slippage_bps_bucket{instance=~\"debot-robinhood.*\",variant!=\"\"}[$__rate_interval])))",
          "legendFormat": "p50 {{variant}} {{order_type}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le, variant, order_type) (rate(pairtrade_leg_slippage_bps_bucket{instance=~\"debot-robinhood.*\",variant!=\"\"}[$__rate_interval])))",
          "legendFormat": "p90 {{variant}} {{order_type}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
