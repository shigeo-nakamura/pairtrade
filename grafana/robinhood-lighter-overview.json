    {
      "id": 9,
      "type": "timeseries",
      "title": "Close gross PnL — windowed average per $__rate_interval (bps of entry notional)",
      "description": "Gross PnL (price moves only, fees+funding excluded) normalized by entry notional, averaged over each $__rate_interval window and plotted as a scatter of those windowed averages — NOT a literal per-close event scatter. When trade cadence is low relative to the window (the common case here), a window usually contains at most one close and the point reads as that close's PnL, but if the panel step drops below the window (e.g. zoomed in) the same close can be re-plotted across consecutive evaluations, and two closes landing in the same window are shown as their average rather than as two points. An explicit `interval` floor is set below to reduce (not eliminate) the re-plotting case. Computed as instant subtraction (`metric - (metric offset $__rate_interval or metric*0)`) rather than delta()/increase(): pairtrade_close_gross_pnl_bps accepts negative (losing) observations, so increase()'s counter-reset compensation would corrupt exactly the loss points this panel exists to show, and plain delta()/increase() both return no data for a (variant,pair,reason) combination's very first-ever close (no earlier sample exists to diff against) — the `or metric*0` fallback treats an absent prior sample as a zero baseline so that first close is still captured. Trade-off: a genuine process restart between the offset sample and now (state re-accumulating from zero) can still show as one spurious large-magnitude point, same as any counter-based approach.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "expr": "(pairtrade_close_gross_pnl_bps_sum{instance=~\"debot-robinhood.*\",variant!=\"\"} - (pairtrade_close_gross_pnl_bps_sum{instance=~\"debot-robinhood.*\",variant!=\"\"} offset $__rate_interval or pairtrade_close_gross_pnl_bps_sum{instance=~\"debot-robinhood.*\",variant!=\"\"} * 0)) / (pairtrade_close_gross_pnl_bps_count{instance=~\"debot-robinhood.*\",variant!=\"\"} - (pairtrade_close_gross_pnl_bps_count{instance=~\"debot-robinhood.*\",variant!=\"\"} offset $__rate_interval or pairtrade_close_gross_pnl_bps_count{instance=~\"debot-robinhood.*\",variant!=\"\"} * 0))",
          "legendFormat": "{{variant}} {{reason}}",
          "interval": "1m",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "points",
            "pointSize": 6,
            "spanNulls": false,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* exit_z$"
            },
            "properties": [
              {
