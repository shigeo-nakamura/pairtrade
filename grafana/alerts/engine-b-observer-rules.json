[
  {
    "uid": "engine-b-observer-feed-stale",
    "title": "Engine B observer has received nothing from a venue for 10 minutes",
    "ruleGroup": "engine-b-phase0",
    "folderUID": "bot-alerts",
    "noDataState": "Alerting",
    "execErrState": "Error",
    "for": "10m",
    "condition": "B",
    "annotations": {
      "summary": "Engine B observer feed for venue {{ $labels.venue }} is stale on {{ $labels.instance }}",
      "description": "engine_b_phase0_last_message_age_seconds stayed above 600 for 10 minutes, or the observer's /metrics endpoint stopped answering (no data alerts). This is the 2026-09-05 failure mode: mainnet silent for ~14.5 h while the process stayed active. Check engine-b-phase0.service, then the venue's WebSocket status."
    },
    "labels": {
      "service": "engine-b-phase0",
      "severity": "warning",
      "source": "grafana"
    },
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "__PROMETHEUS_UID__",
        "model": {
          "expr": "engine_b_phase0_last_message_age_seconds",
          "hide": false,
          "instant": true,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "-100",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  600
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": [
                  "A"
                ]
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "-100"
          },
          "hide": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "B",
          "type": "classic_conditions"
        }
      }
    ]
  },
  {
    "uid": "engine-b-observer-books-unsynced",
    "title": "Engine B observer has unsynced order books for 30 minutes",
    "ruleGroup": "engine-b-phase0",
    "folderUID": "bot-alerts",
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "30m",
    "condition": "B",
    "annotations": {
      "summary": "Engine B observer has unsynced order books on {{ $labels.instance }}",
      "description": "count(engine_b_phase0_book_synced == 0) stayed above 0 for 30 minutes. A reconnect burst leaving most markets without a fresh snapshot (bot-strategy#908 item 2) looks exactly like this; a venue-side halt of one market does too, so identify which market_id before restarting anything. Active/connected alone is not healthy."
    },
    "labels": {
      "service": "engine-b-phase0",
      "severity": "warning",
      "source": "grafana"
    },
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "__PROMETHEUS_UID__",
        "model": {
          "expr": "count(engine_b_phase0_book_synced == 0)",
          "hide": false,
          "instant": true,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "-100",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": [
                  "A"
                ]
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "-100"
          },
          "hide": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "B",
          "type": "classic_conditions"
        }
      }
    ]
  }
]
