[
  {
    "uid": "pairtrade-no-trade-72h",
    "title": "Pairtrade no completed trade for 72h",
    "ruleGroup": "bot-fleet",
    "folderUID": "bot-alerts",
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "30m",
    "condition": "B",
    "annotations": {
      "summary": "Pairtrade {{ $labels.instance }} / {{ $labels.variant }} has not completed a trade for 72h",
      "description": "pairtrade_time_since_last_trade_seconds stayed above 259200 seconds for 30 minutes. Check eligibility, market data, risk gates, and position state."
    },
    "labels": { "service": "pairtrade", "severity": "warning", "source": "grafana" },
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "__PROMETHEUS_UID__",
        "model": {
          "expr": "pairtrade_time_since_last_trade_seconds >= 259200",
          "hide": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "datasourceUid": "-100",
        "model": {
          "conditions": [{
            "evaluator": { "params": [0], "type": "gt" },
            "operator": { "type": "and" },
            "query": { "params": ["A"] },
            "reducer": { "params": [], "type": "last" },
            "type": "query"
          }],
          "datasource": { "type": "__expr__", "uid": "-100" },
          "hide": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "B",
          "type": "classic_conditions"
        }
      }
    ]
  },
  {
    "uid": "pairtrade-halt-rising-edge",
    "title": "Pairtrade risk halt engaged",
    "ruleGroup": "bot-fleet",
    "folderUID": "bot-alerts",
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "0s",
    "condition": "B",
    "annotations": {
      "summary": "Pairtrade halt engaged",
      "description": "A pairtrade kill switch, session-DD halt, daily-DD halt, or circuit breaker changed from inactive to active in the last 5 minutes."
    },
    "labels": { "service": "pairtrade", "severity": "critical", "source": "grafana" },
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "__PROMETHEUS_UID__",
        "model": {
          "expr": "(changes(pairtrade_kill_switch_active[5m]) > 0 and pairtrade_kill_switch_active == 1) or (changes(pairtrade_session_dd_halt_active[5m]) > 0 and pairtrade_session_dd_halt_active == 1) or (changes(pairtrade_daily_dd_halt_active[5m]) > 0 and pairtrade_daily_dd_halt_active == 1) or (changes(pairtrade_circuit_breaker_active[5m]) > 0 and pairtrade_circuit_breaker_active == 1)",
          "hide": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "datasourceUid": "-100",
        "model": {
          "conditions": [{
            "evaluator": { "params": [0], "type": "gt" },
            "operator": { "type": "and" },
            "query": { "params": ["A"] },
            "reducer": { "params": [], "type": "last" },
            "type": "query"
          }],
          "datasource": { "type": "__expr__", "uid": "-100" },
          "hide": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "B",
          "type": "classic_conditions"
        }
      }
    ]
  },
  {
