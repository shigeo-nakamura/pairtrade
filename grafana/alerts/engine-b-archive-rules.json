  {
    "uid": "engine-b-archive-stalled",
    "title": "Engine B has eligible partitions but no verified removal in three hours",
    "ruleGroup": "engine-b-phase0",
    "folderUID": "bot-alerts",
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "15m",
    "condition": "C",
    "annotations": {
      "summary": "Engine B archive drain stalled on debot-robinhood-lighter (Tokyo)",
      "description": "engine_b_phase0_archive_eligible_partition_count is above 0 while the newest local seal whose source DB is gone is older than 10800 seconds, for 15 minutes. Successful no-op systemd runs do not count; only the verified-deletion path produces a qualifying seal. Assumes DELETE_VERIFIED_LOCAL=true and 24 h retention."
    },
    "labels": {
      "service": "engine-b-phase0",
      "severity": "warning",
      "source": "grafana"
    },
