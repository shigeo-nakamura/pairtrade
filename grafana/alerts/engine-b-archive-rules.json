  {
    "uid": "engine-b-archive-disk-low",
    "title": "Engine B archive filesystem below 5 GiB or 15 percent free",
    "ruleGroup": "engine-b-phase0",
    "folderUID": "bot-alerts",
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "5m",
    "condition": "C",
    "annotations": {
      "summary": "Engine B archive filesystem on debot-robinhood-lighter (Tokyo) is low on space",
      "description": "engine_b_phase0_archive_disk_available_bytes is below 5 GiB or below 15 percent of the filesystem for 5 minutes. The hourly archiver's preflight refuses to run when free space is below 4x the partition size + 512 MiB, so a low disk stops the drain and the observer's own writes then fill the host. Initial operational thresholds, not a measured capacity guarantee."
    },
    "labels": {
      "service": "engine-b-phase0",
      "severity": "warning",
      "source": "grafana"
    },
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "__PROMETHEUS_UID__",
        "model": {
          "expr": "engine_b_phase0_archive_disk_available_bytes",
          "hide": false,
          "instant": true,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "__PROMETHEUS_UID__",
